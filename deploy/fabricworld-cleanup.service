[Unit]
Description=FabricWorld business data cleanup on NAS
ConditionPathExists=/etc/server-maintenance-host
After=systemd-tmpfiles-setup.service

[Service]
Type=oneshot
User=fabricworld
Group=fabricworld
ExecCondition=/usr/bin/grep -qx nas /etc/server-maintenance-host
# The NAS foundation creates root-owned locks that runtime users open read-only.
ExecStart=/usr/bin/flock --shared /run/lock/server-maintenance.lock /usr/bin/flock --exclusive /run/lock/fabricworld-deploy.lock /opt/fabricworld/bin/fabricworld cleanup --data /opt/fabricworld/data
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/fabricworld/data
MemoryMax=256M
CPUQuota=50%
Nice=10
TimeoutStartSec=15min
